<Application x:Class="DocShot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- System Tray Context Menu -->
            <ContextMenu x:Key="TrayContextMenu" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1">
                <MenuItem Header="Take Screenshot" Click="MenuTakeScreenshot_Click" FontWeight="Bold" Foreground="#89B4FA"/>
                <MenuItem Header="Run DPI Spike Test" Click="MenuRunDpiSpike_Click" Foreground="#CDD6F4"/>
                <Separator Background="#313244"/>
                <MenuItem Header="Settings..." Click="MenuSettings_Click" Foreground="#CDD6F4"/>
                <Separator Background="#313244"/>
                <MenuItem Header="Exit DocShot" Click="MenuExit_Click" Foreground="#F38BA8"/>
            </ContextMenu>
        </ResourceDictionary>
    </Application.Resources>
</Application>
