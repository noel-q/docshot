<Window x:Class="DocShot.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DocShot Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#22000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Canvas for Background, Window Highlight, Selection, and Annotation rendering -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent"
                MouseDown="OverlayCanvas_MouseDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseUp="OverlayCanvas_MouseUp">

            <!-- Captured Screen Image Background (Shown after selection) -->
            <Image x:Name="CapturedBackgroundImage" Stretch="Fill" Visibility="Collapsed" />

            <!-- Window Hover Highlight Box -->
            <Rectangle x:Name="WindowHighlightBox"
                       Stroke="#A6E3A1"
                       StrokeThickness="2.5"
                       Fill="#15A6E3A1"
                       Visibility="Collapsed" />

            <!-- Window Hover Tooltip Badge -->
            <Border x:Name="WindowHoverBadge"
                    Background="#EE181825"
                    CornerRadius="6"
                    Padding="10,6"
                    BorderBrush="#A6E3A1"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HoverTitleText" Text="Chrome" FontWeight="Bold" Foreground="#A6E3A1" FontSize="12" />
                    <TextBlock x:Name="HoverProcessText" Text=" (chrome.exe)" Foreground="#CDD6F4" FontSize="11" Margin="4,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Selection Drag Box -->
            <Rectangle x:Name="SelectionBox"
                       Stroke="#89B4FA"
                       StrokeThickness="2"
                       Fill="#1589B4FA"
                       Visibility="Collapsed" />

            <!-- Selection Dimension Badge -->
            <Border x:Name="DimensionBadge"
                    Background="#F51E1E2E"
                    CornerRadius="6"
                    Padding="10,6"
                    BorderBrush="#89B4FA"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DipDimText" Text="DIPs: 0 x 0" Foreground="#89B4FA" FontWeight="Bold" FontSize="12" />
                    <TextBlock x:Name="PhysDimText" Text="Source Pixels: 0 x 0" Foreground="#A6E3A1" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Top Monitor Info Badge -->
            <Border x:Name="MonitorBadge" Canvas.Top="20" Canvas.Left="20"
                    Background="#EE1E1E2E" CornerRadius="8" Padding="14,10"
                    BorderBrush="#4489B4FA" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BadgeTitle" Text="DISPLAY 1" FontWeight="Bold" Foreground="#F5E0DC" FontSize="14" />
                        <Border x:Name="PrimaryTag" Margin="8,0,0,0" Background="#33A6E3A1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="PRIMARY" Foreground="#A6E3A1" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border x:Name="FakesTag" Margin="8,0,0,0" Background="#33F9E2AF" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="FAKES MODE" Foreground="#F9E2AF" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="BadgeDetails" Text="Bounds: 2560x1440 | DPI: 144 (150% Scale)" Foreground="#CDD6F4" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="Hover window to select | Drag region to capture" Foreground="#A6ADC8" FontSize="11" Margin="0,4,0,0" FontStyle="Italic" />
                </StackPanel>
            </Border>

            <!-- DPI Round-Trip Result Card -->
            <Border x:Name="ResultCard" Canvas.Bottom="30" Canvas.Left="20"
                    Background="#F5181825" CornerRadius="10" Padding="16,12"
                    BorderBrush="#A6E3A1" BorderThickness="1.5"
                    Visibility="Collapsed" Width="480">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="DPI ROUND-TRIP PROOF RESULT:" FontWeight="Bold" Foreground="#CDD6F4" FontSize="13"/>
                        <TextBlock x:Name="ResultStatusText" Text=" PASS" FontWeight="Bold" Foreground="#A6E3A1" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultDetailsText" Text="" Foreground="#BAC2DE" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Action Toast Notification -->
            <Border x:Name="ToastNotification" Canvas.Top="80" Canvas.Left="20"
                    Background="#EEA6E3A1" CornerRadius="8" Padding="14,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Text="Copied PNG to Clipboard!" Foreground="#11111B" FontWeight="Bold" FontSize="13" />
            </Border>
        </Canvas>

        <!-- Floating Annotation & Action Toolbar (Appears after selection) -->
        <Border x:Name="AnnotationToolbar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                Background="#F51E1E2E" CornerRadius="10" Padding="12,8"
                BorderBrush="#89B4FA" BorderThickness="1.5" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">

                <!-- Annotation Tools -->
                <TextBlock Text="Tool:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                <RadioButton x:Name="ToolSelect" Content="Select" Tag="Select" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolArrow" Content="Arrow" Tag="Arrow" IsChecked="True" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolRectangle" Content="Rect" Tag="Rectangle" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolEllipse" Content="Ellipse" Tag="Ellipse" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolText" Content="Text" Tag="Text" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolHighlighter" Content="Highlighter" Tag="Highlighter" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,4,0"/>
                <RadioButton x:Name="ToolRedaction" Content="Redact" Tag="Redaction" Click="Tool_Click" GroupName="Tools" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,10,0"/>

                <Separator Width="1" Height="20" Background="#45475A" Margin="0,0,10,0"/>

                <!-- Color Swatches -->
                <TextBlock Text="Color:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                <Button x:Name="ColorRedBtn" Width="20" Height="20" Background="#F38BA8" Margin="0,0,4,0" Click="Color_Click" Tag="Red" ToolTip="Red"/>
                <Button x:Name="ColorGreenBtn" Width="20" Height="20" Background="#A6E3A1" Margin="0,0,4,0" Click="Color_Click" Tag="Green" ToolTip="Green"/>
                <Button x:Name="ColorBlueBtn" Width="20" Height="20" Background="#89B4FA" Margin="0,0,4,0" Click="Color_Click" Tag="Blue" ToolTip="Blue"/>
                <Button x:Name="ColorYellowBtn" Width="20" Height="20" Background="#F9E2AF" Margin="0,0,4,0" Click="Color_Click" Tag="Yellow" ToolTip="Yellow"/>
                <Button x:Name="ColorWhiteBtn" Width="20" Height="20" Background="#FFFFFF" Margin="0,0,10,0" Click="Color_Click" Tag="White" ToolTip="White"/>

                <Separator Width="1" Height="20" Background="#45475A" Margin="0,0,10,0"/>

                <!-- Undo / Redo -->
                <Button x:Name="UndoBtn" Content="Undo" Click="Undo_Click" Padding="8,4" Margin="0,0,4,0" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
                <Button x:Name="RedoBtn" Content="Redo" Click="Redo_Click" Padding="8,4" Margin="0,0,10,0" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>

                <Separator Width="1" Height="20" Background="#45475A" Margin="0,0,10,0"/>

                <!-- Output Actions -->
                <Button x:Name="CopyPngBtn" Content="Copy PNG" Click="CopyPng_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="12,4" Margin="0,0,6,0" BorderThickness="0"/>
                <Button x:Name="SaveBtn" Content="Save..." Click="Save_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="12,4" Margin="0,0,6,0" BorderThickness="0"/>
                <Button x:Name="DiscardBtn" Content="Discard" Click="Discard_Click" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="12,4" BorderThickness="0"/>

            </StackPanel>
        </Border>

        <!-- Close Overlay Button -->
        <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" Padding="12,8"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                Click="CloseButton_Click" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
            <TextBlock Text="Close Overlay (Esc)" FontWeight="SemiBold" FontSize="12"/>
        </Button>
    </Grid>
</Window>
