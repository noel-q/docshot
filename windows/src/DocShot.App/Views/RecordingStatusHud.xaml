<Window x:Class="DocShot.App.Views.RecordingStatusHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocShot Recording HUD"
        Height="50" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#EE181825"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border CornerRadius="10" BorderBrush="#F38BA8" BorderThickness="1.5" Padding="12,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pulsing Red Recording Indicator Dot -->
            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#F38BA8" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Timer Text -->
            <TextBlock x:Name="TimerText" Grid.Column="1" Text="00:00" Foreground="#CDD6F4" FontWeight="Bold" FontSize="16" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- Audio Mode Badge -->
            <Border Grid.Column="2" Background="#313244" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock x:Name="AudioStatusText" Text="Muted" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <!-- Action Controls: Pause, Stop, Discard -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseBtn" Content="⏸" Click="PauseBtn_Click" Width="28" Height="28" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Margin="0,0,4,0" ToolTip="Pause Recording"/>
                <Button x:Name="StopBtn" Content="⏹ Stop" Click="StopBtn_Click" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="8,4" BorderThickness="0" Margin="0,0,4,0" ToolTip="Stop and Save Recording"/>
                <Button x:Name="DiscardBtn" Content="✕" Click="DiscardBtn_Click" Width="28" Height="28" Background="#313244" Foreground="#BAC2DE" BorderThickness="0" ToolTip="Discard Recording"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
