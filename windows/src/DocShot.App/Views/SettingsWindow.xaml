<Window x:Class="DocShot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocShot Settings"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DocShot" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                <TextBlock Text=" Settings &amp; Diagnostics" FontSize="22" FontWeight="SemiBold" Foreground="#CDD6F4"/>
            </StackPanel>
            <TextBlock Text="Windows Port Scaffold — Mixed-DPI &amp; App Shell" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tabbed / Sectioned Content -->
        <TabControl Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" Padding="12,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#1E1E2E"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: General & Hotkeys -->
            <TabItem Header="General">
                <StackPanel Margin="20">
                    <TextBlock Text="Shortcuts &amp; Behavior" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Capture Hotkey" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Global shortcut to trigger full-screen selection" FontSize="11" Foreground="#A6ADC8"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="Ctrl + Shift + S" IsReadOnly="True" Background="#313244" Foreground="#89B4FA"
                                 BorderBrush="#45475A" Padding="8,6" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                    </Grid>

                    <Separator Background="#313244" Margin="0,0,0,16"/>

                    <CheckBox Content="Launch DocShot on Windows startup" Foreground="#CDD6F4" FontSize="13"/>
                    <CheckBox Content="Play shutter sound on capture" Foreground="#CDD6F4" FontSize="13" Margin="0,10,0,0" IsChecked="True"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: DPI & Multi-Monitor Diagnostics -->
            <TabItem Header="Multi-Monitor &amp; DPI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Connected Display Monitors" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,8"/>
                        <TextBlock Text="DocShot.App runs in PerMonitorV2 High DPI mode. Verify scale factors and DIP bounds below:" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,12"/>

                        <!-- Monitors List -->
                        <ItemsControl x:Name="MonitorsListView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313244" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="#45475A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="#89B4FA" FontSize="13"/>
                                                    <TextBlock Text=" [PRIMARY]" FontWeight="Bold" Foreground="#A6E3A1" FontSize="11" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PhysicalDetails}" FontSize="11" Foreground="#CDD6F4" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding DipDetails}" FontSize="11" Foreground="#BAC2DE"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#45475A" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScaleText}" FontWeight="Bold" Foreground="#F9E2AF" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#313244" Margin="0,10,0,16"/>

                        <!-- Actions -->
                        <TextBlock Text="Risk Spike Controls" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="RunSpikeTestButton" Content="Run Automated DPI Verification" Click="RunSpikeTestButton_Click"
                                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button x:Name="ShowOverlaysButton" Content="Launch Selection Overlays" Click="ShowOverlaysButton_Click"
                                    Background="#313244" Foreground="#89B4FA" FontWeight="Bold" Padding="14,8" BorderBrush="#89B4FA" BorderThickness="1" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Log / Results output -->
                        <TextBox x:Name="SpikeOutputBox" Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#11111B" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="11" Padding="8" IsReadOnly="True"
                                 Text="Click 'Run Automated DPI Verification' to test pixel round-trip conversion on all monitors."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="CloseButton_Click" Width="90" Padding="0,6" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
        </StackPanel>
    </Grid>
</Window>
