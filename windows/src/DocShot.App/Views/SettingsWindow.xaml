<Window x:Class="DocShot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocShot Settings"
        Height="580" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DocShot" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                <TextBlock Text=" Settings &amp; Recording Options" FontSize="22" FontWeight="SemiBold" Foreground="#CDD6F4"/>
            </StackPanel>
            <TextBlock Text="Windows Port — PARITY_CHECKLIST §5 Behavior Contract" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" Padding="12,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#1E1E2E"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Recording & Capture Settings -->
            <TabItem Header="Recording Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Recording &amp; Capture Settings (RecordingOptions)" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,12"/>

                        <!-- Audio Mode -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="System Audio Mode" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Audio off by default per product rules (PARITY_CHECKLIST.md §1)" FontSize="11" Foreground="#A6ADC8"/>
                            </StackPanel>
                            <ComboBox x:Name="AudioModeComboBox" Grid.Column="1" Background="#313244" Foreground="#CDD6F4" Padding="8,4">
                                <ComboBoxItem Content="Audio Off (Default)" IsSelected="True"/>
                                <ComboBoxItem Content="Capture System Audio"/>
                            </ComboBox>
                        </Grid>

                        <!-- Cursor Visibility -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Show Mouse Cursor" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Include mouse pointer overlay during capture and recording" FontSize="11" Foreground="#A6ADC8"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowCursorCheckBox" Grid.Column="1" Content="Visible in output" IsChecked="True" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Frame Rate -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Maximum Frame Rate" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Target FPS for screen recording" FontSize="11" Foreground="#A6ADC8"/>
                            </StackPanel>
                            <ComboBox x:Name="FrameRateComboBox" Grid.Column="1" Background="#313244" Foreground="#CDD6F4" Padding="8,4">
                                <ComboBoxItem Content="60 FPS (High Smoothness)" IsSelected="True"/>
                                <ComboBoxItem Content="30 FPS (Standard)"/>
                                <ComboBoxItem Content="15 FPS (Compact)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Recording & Capture Shortcuts -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Capture Shortcut" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="HotkeyStatusText" Text="Status: Registered (Ctrl+Shift+S)" FontSize="11" Foreground="#A6E3A1"/>
                            </StackPanel>
                            <TextBox Text="Ctrl + Shift + S" IsReadOnly="True" Background="#313244" Foreground="#89B4FA"
                                     BorderBrush="#45475A" Padding="8,6" HorizontalContentAlignment="Center" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>

                        <Separator Background="#313244" Margin="0,4,0,16"/>

                        <!-- GIF Eligibility Guardrails Info Box -->
                        <Border Background="#181825" CornerRadius="8" Padding="14,10" BorderBrush="#F9E2AF" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="GIF Export Eligibility Guardrails (GifProfile.DocShotDefault):" FontWeight="Bold" Foreground="#F9E2AF" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="• Maximum Duration: 15.0 seconds | Maximum File Size: 10 MB" Foreground="#CDD6F4" FontSize="11"/>
                                <TextBlock Text="• Maximum Resolution: 960 px | Maximum FPS: 10 FPS | Audio: Silent" Foreground="#CDD6F4" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="Exceeding guardrails falls back to keeping MP4 output — never truncated or corrupt GIF." Foreground="#A6ADC8" FontSize="10" FontStyle="Italic" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Service Provider & Multi-Monitor Diagnostics -->
            <TabItem Header="Platform Engine &amp; DPI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Services Engine Mode" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Platform Services Provider" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="ServiceModeDesc" Text="Currently using DocShot.Core.Fakes (In-Memory Fakes)" FontSize="11" Foreground="#F9E2AF"/>
                            </StackPanel>
                            <Button x:Name="ToggleServiceModeBtn" Content="Switch to Win32 Platform" Click="ToggleServiceModeBtn_Click"
                                    Background="#313244" Foreground="#89B4FA" FontWeight="Bold" Padding="10,6" BorderBrush="#89B4FA" BorderThickness="1" Grid.Column="1"/>
                        </Grid>

                        <Separator Background="#313244" Margin="0,0,0,16"/>

                        <TextBlock Text="Connected Display Monitors" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,8"/>
                        <TextBlock Text="DocShot.App runs in PerMonitorV2 High DPI mode. Connected displays:" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,12"/>

                        <!-- Monitors List -->
                        <ItemsControl x:Name="MonitorsListView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313244" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="#45475A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="#89B4FA" FontSize="13"/>
                                                    <TextBlock Text=" [PRIMARY]" FontWeight="Bold" Foreground="#A6E3A1" FontSize="11" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PhysicalDetails}" FontSize="11" Foreground="#CDD6F4" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding DipDetails}" FontSize="11" Foreground="#BAC2DE"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#45475A" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScaleText}" FontWeight="Bold" Foreground="#F9E2AF" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#313244" Margin="0,10,0,16"/>

                        <!-- Actions -->
                        <TextBlock Text="Risk Spike Controls" FontSize="14" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="RunSpikeTestButton" Content="Run Automated DPI Verification" Click="RunSpikeTestButton_Click"
                                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button x:Name="ShowOverlaysButton" Content="Launch Selection Overlays" Click="ShowOverlaysButton_Click"
                                    Background="#313244" Foreground="#89B4FA" FontWeight="Bold" Padding="14,8" BorderBrush="#89B4FA" BorderThickness="1" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Log / Results output -->
                        <TextBox x:Name="SpikeOutputBox" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#11111B" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="11" Padding="8" IsReadOnly="True"
                                 Text="Click 'Run Automated DPI Verification' to test pixel round-trip conversion on all monitors."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="CloseButton_Click" Width="90" Padding="0,6" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
        </StackPanel>
    </Grid>
</Window>
